# Ollama server URL (default: local)
OLLAMA_BASE_URL=http://localhost:11434

# Default model to use when none is specified in a request
DEFAULT_MODEL=gemma3:4b

# Comma-separated list of allowed model names
# Add any model you have pulled in Ollama
ALLOWED_MODELS=["gemma3:4b"]

# Max simultaneous Ollama inference calls
MAX_CONCURRENT_OLLAMA_REQUESTS=2

# Max requests waiting in queue before returning 503
MAX_QUEUE_SIZE=10

# Seconds before a single LLM call is aborted with 504
REQUEST_TIMEOUT_SECONDS=120.0

# Rolling window: how many messages to keep per session
MAX_MESSAGES_PER_SESSION=20

# Seconds to keep model loaded in Ollama after last request (-1 = forever)
OLLAMA_KEEP_ALIVE=-1

# Database — leave empty to fall back to in-memory store (local dev without Docker)
DATABASE_URL=postgresql://aiserver:aiserver@postgres:5432/aiserver

# Auth
# Secret key for signing JWTs — change this to a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# Comma-separated list of admin emails — these bypass the allowlist and get is_admin=true
# Example: ADMIN_EMAILS=demitard@email.co,other@gmail.com
ADMIN_EMAILS=example@example.com
