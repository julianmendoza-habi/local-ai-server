# Ollama server URL (default: local)
OLLAMA_BASE_URL=http://localhost:11434

# Default model to use when none is specified in a request
DEFAULT_MODEL=gemma4:e2b

# Comma-separated list of allowed model names
# Add any model you have pulled in Ollama
ALLOWED_MODELS=["gemma4:e2b", "llama3", "mistral"]

# Max simultaneous Ollama inference calls
MAX_CONCURRENT_OLLAMA_REQUESTS=2

# Max requests waiting in queue before returning 503
MAX_QUEUE_SIZE=10

# Seconds before a single LLM call is aborted with 504
REQUEST_TIMEOUT_SECONDS=120.0

# Rolling window: how many messages to keep per session
MAX_MESSAGES_PER_SESSION=20

# Seconds to keep model loaded in Ollama after last request (-1 = forever, 300 = 5 min)
OLLAMA_KEEP_ALIVE=-1
