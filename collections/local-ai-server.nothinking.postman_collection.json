                  "  pm.expect(pm.response.json().detail).to.include('00000000-0000-0000-0000-000000000000');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /chat — 400 model not allowed",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/chat",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Test\",\n  \"model\": \"{{disallowedModel}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('detail mentions the model name', () => {",
                  "  pm.expect(pm.response.json().detail).to.include(pm.collectionVariables.get('disallowedModel'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /chat — 422 empty message",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/chat",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 422 Unprocessable Entity', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /chat — 422 missing message field",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/chat",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"gemma3:4b\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 422 Unprocessable Entity', () => pm.response.to.have.status(422));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /chat/{chatId} — 404 non-existent session",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/chat/00000000-0000-0000-0000-000000000000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /chat/{chatId}/stream — 404 non-existent session",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/chat/00000000-0000-0000-0000-000000000000/stream?message=test",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "00000000-0000-0000-0000-000000000000", "stream"],
              "query": [{ "key": "message", "value": "test" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /chat/{chatId} — 404 non-existent session",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/chat/00000000-0000-0000-0000-000000000000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "08 · Delete sessions",
      "item": [
        {
          "name": "DELETE /chat/{chatId} — delete main session",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/chat/{{chatId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('DeleteResponse schema is correct', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.deleted).to.be.true;",
                  "  pm.expect(b.chat_id).to.equal(pm.collectionVariables.get('chatId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /chat/{chatId} — 404 after delete",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/chat/{{chatId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 404 after delete', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /chat/{streamChatId} — clean up stream session",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/chat/{{streamChatId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('deleted is true', () => pm.expect(pm.response.json().deleted).to.be.true);"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
