{
  "info": {
    "name": "Local AI Server — Thinking",
    "description": "Collection for models that support thinking mode (e.g. deepseek-r1, qwq). Covers all modes including thinking and POST /chat/stream. Run with Newman using --timeout-request 180000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "chatId",
      "value": "",
      "type": "string"
    },
    {
      "key": "thinkingChatId",
      "value": "",
      "type": "string"
    },
    {
      "key": "streamChatId",
      "value": "",
      "type": "string"
    },
    {
      "key": "allowedModel",
      "value": "deepseek-r1:7b",
      "type": "string",
      "description": "Must match a thinking-capable model in ALLOWED_MODELS in your .env."
    },
    {
      "key": "disallowedModel",
      "value": "gpt-99",
      "type": "string",
      "description": "A model name intentionally NOT in ALLOWED_MODELS. Used to verify the 400 rejection path."
    },
    {
      "key": "adminEmail",
      "value": "",
      "type": "string",
      "description": "Admin email — pass at run time: --env-var adminEmail=you@example.com"
    },
    {
      "key": "adminPassword",
      "value": "",
      "type": "string",
      "description": "Admin password — pass at run time: --env-var adminPassword=yourpassword"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string",
      "description": "JWT — set automatically by the login request in folder 00."
    }
  ],
  "item": [
    {
      "name": "00 · Auth",
      "item": [
        {
          "name": "POST /auth/login — obtain token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "description": "Logs in with admin credentials and stores the JWT in the authToken collection variable. All subsequent requests use it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('response has access_token', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b).to.have.property('access_token').that.is.a('string').with.length.above(0);",
                  "  pm.expect(b.token_type).to.equal('bearer');",
                  "  pm.collectionVariables.set('authToken', b.access_token);",
                  "  console.log('authToken saved');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /auth/me — verify token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "description": "Confirms the token is valid and returns the logged-in user profile."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('profile has expected fields', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b).to.have.property('id').that.is.a('string');",
                  "  pm.expect(b).to.have.property('email').that.is.a('string');",
                  "  pm.expect(b).to.have.property('is_admin');",
                  "  pm.expect(b.email).to.equal(pm.collectionVariables.get('adminEmail'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 · Health",
      "item": [
        {
          "name": "GET /health — server is up",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('body is {status: ok}', () => {",
                  "  pm.expect(pm.response.json()).to.deep.equal({ status: 'ok' });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 · Chat — new session",
      "item": [
        {
          "name": "POST /chat — new session with default model",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/chat",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"What is recursion? Answer in one sentence.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('response has required fields', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b).to.have.property('chat_id').that.is.a('string').with.length.above(0);",
                  "  pm.expect(b).to.have.property('model').that.is.a('string');",
                  "  pm.expect(b).to.have.property('reply').that.is.a('string').with.length.above(0);",
                  "  pm.expect(b).to.have.property('messages').that.is.an('array').with.length.above(0);",
                  "});",
                  "",
                  "pm.test('messages contains the user turn', () => {",
                  "  pm.expect(pm.response.json().messages.some(m => m.role === 'human')).to.be.true;",
                  "});",
                  "",
                  "pm.collectionVariables.set('chatId', pm.response.json().chat_id);",
                  "console.log('chatId saved:', pm.response.json().chat_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /chat — new session in nothinking mode",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/chat",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"How much is 7 times 8?\",\n  \"mode\": \"nothinking\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('thinking is null in nothinking mode', () => {",
                  "  pm.expect(pm.response.json().thinking).to.be.null;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /chat — new session in thinking mode",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/chat",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"What is 17 times 38? Show the steps.\",\n  \"mode\": \"thinking\"\n}"
            },
            "description": "Creates a session with mode=thinking. Saves thinkingChatId."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('has chat_id and non-empty reply', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.chat_id).to.be.a('string');",
                  "  pm.expect(b.reply).to.be.a('string').with.length.above(0);",
                  "});",
                  "",
                  "pm.collectionVariables.set('thinkingChatId', pm.response.json().chat_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /chat — new session with explicit model",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/chat",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Tell me your name.\",\n  \"model\": \"{{allowedModel}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('response model matches requested model', () => {",
                  "  pm.expect(pm.response.json().model).to.equal(pm.collectionVariables.get('allowedModel'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 · Chat — continue session",
      "item": [
        {
          "name": "POST /chat — continue existing session",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/chat",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Give me a Python code example.\",\n  \"chat_id\": \"{{chatId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('chat_id does not change', () => {",
                  "  pm.expect(pm.response.json().chat_id).to.equal(pm.collectionVariables.get('chatId'));",
                  "});",
                  "",
                  "pm.test('accumulated history has at least 4 messages', () => {",
                  "  pm.expect(pm.response.json().messages.length).to.be.at.least(4);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /chat — continue session switching to thinking mode",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/chat",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Does that code have any potential bugs?\",\n  \"chat_id\": \"{{chatId}}\",\n  \"mode\": \"thinking\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('chat_id is consistent', () => {",
                  "  pm.expect(pm.response.json().chat_id).to.equal(pm.collectionVariables.get('chatId'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 · Chat — get history",
      "item": [
        {
          "name": "GET /chat/{chatId} — history of active session",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/chat/{{chatId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('ChatHistoryResponse schema', () => {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.chat_id).to.equal(pm.collectionVariables.get('chatId'));",
                  "  pm.expect(b).to.have.property('model').that.is.a('string');",
                  "  pm.expect(b).to.have.property('created_at').that.is.a('string');",
                  "  pm.expect(b).to.have.property('messages').that.is.an('array');",
                  "});",
                  "",
                  "pm.test('each message has role and content', () => {",
                  "  pm.response.json().messages.forEach(m => {",
                  "    pm.expect(m).to.have.property('role');",
                  "    pm.expect(m).to.have.property('content');",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 · Streaming — GET (existing session)",
      "item": [
        {
          "name": "GET /chat/{chatId}/stream — nothinking",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/chat/{{chatId}}/stream?message=Summarise+the+conversation+in+one+sentence.&mode=nothinking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "{{chatId}}",
                "stream"
              ],
              "query": [
                {
                  "key": "message",
                  "value": "Summarise the conversation in one sentence."
                },
                {
                  "key": "mode",
                  "value": "nothinking"
                }
              ]
            },
            "timeout": 180000,
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Content-Type is text/event-stream', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/event-stream');",
                  "});",
                  "",
                  "pm.test('body contains at least one data event', () => {",
                  "  pm.expect(pm.response.text()).to.include('data:');",
                  "});",
                  "",
                  "pm.test('body contains done=true event', () => {",
                  "  pm.expect(pm.response.text()).to.match(/\"done\"\\s*:\\s*true/);",
                  "});",
                  "",
                  "pm.test('done event contains chat_id and model', () => {",
                  "  const raw = pm.response.text();",
                  "  const doneEvent = raw.split('\\n').find(l => l.startsWith('data:') && /\"done\"\\s*:\\s*true/.test(l));",
                  "  if (doneEvent) {",
                  "    const payload = JSON.parse(doneEvent.replace(/^data:\\s*/, '').trim());",
                  "    pm.expect(payload).to.have.property('chat_id');",
                  "    pm.expect(payload).to.have.property('model');",
                  "  }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /chat/{thinkingChatId}/stream — thinking mode",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/chat/{{thinkingChatId}}/stream?message=Give+me+a+similar+calculation.&mode=thinking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "{{thinkingChatId}}",
                "stream"
              ],
              "query": [
                {
                  "key": "message",
                  "value": "Give me a similar calculation."
                },
                {
                  "key": "mode",
                  "value": "thinking"
                }
              ]
            },
            "timeout": 180000,
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('body contains done event', () => {",
                  "  pm.expect(pm.response.text()).to.match(/\"done\"\\s*:\\s*true/);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "06 · Streaming — POST (new and existing session)",
      "item": [
        {
          "name": "POST /chat/stream — new session",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/chat/stream",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"What is a closure in programming?\"\n}"
            },
            "description": "Creates a new session and streams the reply. The chat_id is returned in the done event and saved as streamChatId.",
            "timeout": 180000
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Content-Type is text/event-stream', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/event-stream');",
                  "});",
                  "",
                  "pm.test('body contains at least one token event', () => {",
                  "  pm.expect(pm.response.text()).to.include('\"token\"');",
                  "});",
                  "",
                  "pm.test('body contains done=true event', () => {",
                  "  pm.expect(pm.response.text()).to.match(/\"done\"\\s*:\\s*true/);",
                  "});",
                  "",
                  "pm.test('done event contains chat_id and model — save streamChatId', () => {",
                  "  const raw = pm.response.text();",
                  "  const doneEvent = raw.split('\\n').find(l => l.startsWith('data:') && /\"done\"\\s*:\\s*true/.test(l));",
                  "  pm.expect(doneEvent).to.be.a('string');",
                  "  const payload = JSON.parse(doneEvent.replace(/^data:\\s*/, '').trim());",
                  "  pm.expect(payload).to.have.property('chat_id').that.is.a('string');",
                  "  pm.expect(payload).to.have.property('model').that.is.a('string');",
                  "  pm.collectionVariables.set('streamChatId', payload.chat_id);",
                  "  console.log('streamChatId saved:', payload.chat_id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /chat/stream — continue session in thinking mode",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/chat/stream",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Give me a JavaScript example of that.\",\n  \"chat_id\": \"{{streamChatId}}\",\n  \"mode\": \"thinking\"\n}"
            },
            "timeout": 180000
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('done event returns same chat_id', () => {",
                  "  const raw = pm.response.text();",
                  "  const doneEvent = raw.split('\\n').find(l => l.startsWith('data:') && /\"done\"\\s*:\\s*true/.test(l));",
                  "  pm.expect(doneEvent).to.be.a('string');",
                  "  const payload = JSON.parse(doneEvent.replace(/^data:\\s*/, '').trim());",
                  "  pm.expect(payload.chat_id).to.equal(pm.collectionVariables.get('streamChatId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /chat/stream — 404 non-existent chat_id",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/chat/stream",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Hello\",\n  \"chat_id\": \"00000000-0000-0000-0000-000000000000\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('detail mentions the chat_id', () => {",
                  "  pm.expect(pm.response.json().detail).to.include('00000000-0000-0000-0000-000000000000');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /chat/stream — 400 model not allowed",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/chat/stream",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Test\",\n  \"model\": \"{{disallowedModel}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 400', () => pm.response.to.have.status(400));",
                  "pm.test('detail mentions the model name', () => {",
                  "  pm.expect(pm.response.json().detail).to.include(pm.collectionVariables.get('disallowedModel'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "07 · Error cases",
      "item": [
        {
          "name": "POST /chat — 401 invalid token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/chat",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer not.a.valid.token"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Hello\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 401 — invalid token', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /chat — 401 no token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/chat",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Hello\"\n}"
            },
            "description": "Request without Authorization header. Expects 403 (HTTPBearer returns 403 on missing token)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 403 — missing token', () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/login — 401 wrong password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"wrong-password\"\n}"
            }
          },
          "event": [
